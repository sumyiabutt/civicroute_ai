# Copy to .env (or export in your shell). Every value below has a working default.

# Where the web app finds the MCP server.
CIVICROUTE_MCP_URL=http://127.0.0.1:8777/mcp
CIVICROUTE_MCP_HOST=127.0.0.1
CIVICROUTE_MCP_PORT=8777

# "http" reaches the server over its socket; "inmemory" runs the same FastMCP server inside the
# web process (what Vercel needs, since nothing there stays alive between requests). Leave this
# unset and the app picks inmemory only when the platform exports VERCEL.
# CIVICROUTE_MCP_TRANSPORT=http

# City used when neither the page nor the request names one. Must be a file in cities/.
CIVICROUTE_CITY=lahore

# Point this at ONE network file to run a single-city demo instead of cities/.
CIVICROUTE_ROADS=

# Trip defaults now live in each cities/<city>.json (default_origin / default_destination),
# so an unstated endpoint comes from the selected city rather than from the environment.

# Bedrock / Claude. Requires AWS credentials in the environment, an AWS profile,
# or SSO. Without them the rule-based planner runs automatically.
AWS_REGION=us-east-1
CIVICROUTE_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
CIVICROUTE_MAX_STEPS=8
